{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURORA IDE",
  "version": "8.0.0",
  "identifier": "com.nipscern.aurora-ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AURORA IDE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#101214",
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 15
        }
      },
      {
        "label": "splash",
        "title": "AURORA IDE",
        "url": "splash.html",
        "width": 440,
        "height": 300,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": false,
        "focus": true,
        "backgroundColor": "#101214"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; script-src 'self'; frame-src http://127.0.0.1:*",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Ambiente de desenvolvimento da AURORA: Verilog e processadores SAPHO",
    "longDescription": "AURORA IDE é o ambiente gráfico da AURORA, do NIPS-CERN (UFJF): projetos Verilog e processadores SAPHO, compilação C± pelo YANC, verificação e simulação com Icarus e Verilator, síntese com Yosys, esquemático com Graphviz e ondas no surfer-aurora.",
    "copyright": "NIPS-CERN",
    "publisher": "NIPS-CERN",
    "homepage": "https://nipscern.com",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
